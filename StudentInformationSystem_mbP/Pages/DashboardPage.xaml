<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="StudentInformationSystem_mbP.Pages.DashboardPage"
    NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="18">

            <Label
                Text="STUDENT"
                FontSize="14"
                FontAttributes="Bold"
                TextColor="{StaticResource PrimaryPurple}" />

            <Label
                Text="INFORMATION SYSTEM"
                FontSize="30"
                FontAttributes="Bold" />

            <Label
                x:Name="WelcomeLabel"
                TextColor="{StaticResource SecondaryText}"
                FontSize="14" />

            <Border
                BackgroundColor="{StaticResource CardColor}"
                StrokeThickness="0"
                Padding="25"
                StrokeShape="RoundRectangle 22">

                <VerticalStackLayout>

                    <Label
                        Text="TOTAL STUDENTS"
                        FontSize="12"
                        TextColor="{StaticResource SecondaryText}" />

                    <Label
                        x:Name="TotalStudentsLabel"
                        Text="0"
                        FontSize="55"
                        FontAttributes="Bold"
                        TextColor="{StaticResource PrimaryPurple}" />

                    <ActivityIndicator
                        x:Name="LoadingIndicator"
                        IsVisible="False"
                        IsRunning="False"
                        Color="{StaticResource PrimaryPurple}" />

                </VerticalStackLayout>
            </Border>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="12">

                <Button
                    Grid.Column="0"
                    Text="+  ADD STUDENT"
                    Clicked="AddStudentClicked" />

                <Button
                    Grid.Column="1"
                    Text="VIEW STUDENTS"
                    BackgroundColor="{StaticResource CardLightColor}"
                    Clicked="ViewStudentsClicked" />

            </Grid>

            <Border
                BackgroundColor="{StaticResource CardColor}"
                StrokeThickness="0"
                Padding="20"
                StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="ACCOUNT"
                        FontSize="11"
                        TextColor="{StaticResource SecondaryText}" />

                    <Label
                        x:Name="AccountLabel"
                        FontSize="16"
                        FontAttributes="Bold" />

                </VerticalStackLayout>
            </Border>

            <Button
                Text="LOG OUT"
                BackgroundColor="#2A2633"
                TextColor="{StaticResource LightPurple}"
                Clicked="LogoutClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>